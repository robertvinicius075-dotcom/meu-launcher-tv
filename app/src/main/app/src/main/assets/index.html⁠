function catalogoAplicar() {
    var corpo = document.body;
    var arte = document.querySelector('.arte');
    var extra = document.getElementById('catalogo-extra');
    var botao = document.getElementById('hero-botao');

    var tem = !!(catalogo && catalogo.fileiras && catalogo.fileiras.length &&
                 catalogo.hero && catalogo.hero.length);
    catalogoAtivo = catalogoLigado && tem;

    var focoEmExtra = extra.contains(document.activeElement);

    var antigos = arte.querySelectorAll('.slide-cat');
    for (var a = 0; a < antigos.length; a++) {
        arte.removeChild(antigos[a]);
    }
    extra.innerHTML = '';

    if (!catalogoAtivo) {
        corpo.classList.remove('com-catalogo');
        botao.classList.add('oculto');
        SLIDES = SLIDES_CENAS;
        reconstruirPontos(SLIDES.length);
        slideAtual = -1;
        mostrarSlide(0);
        if (focoEmExtra) {
            var apps = document.querySelector('#apps .item');
            if (apps) {
                apps.focus();
            }
        }
        return;
    }

    corpo.classList.add('com-catalogo');
    heroItens = catalogo.hero;
    SLIDES = [];
    var referencia = document.getElementById('foto-fundo');
    for (var i = 0; i < heroItens.length; i++) {
        var it = heroItens[i];
        var cena = document.createElement('div');
        cena.className = 'slide slide-cat';
        var url = imgTmdb('w1280', it.f);
        cena.style.backgroundImage = "url('" + url + "')";
        arte.insertBefore(cena, referencia);
        var pre = new Image();
        pre.src = url;
        SLIDES.push({
            etiqueta: tipoTexto(it.t) + ' em alta',
            titulo: cortarTexto(it.n, 58),
            logo: it.l ? imgTmdb('w500', it.l) : '',
            meta: it.v > 0 ? '★ ' + it.v.toFixed(1) : tipoTexto(it.t),
            desc: (it.a ? it.a + '  ·  ' : '') + tipoTexto(it.t) + '  ·  ' + cortarTexto(it.s, 130)
        });
    }
    reconstruirPontos(SLIDES.length);
    botao.classList.remove('oculto');

    for (var q = 0; q < catalogo.fileiras.length; q++) {
        var f = catalogo.fileiras[q];
        if (f.app && !appDoServico(f.app)) {
            continue;
        }
        var titulo = document.createElement('h2');
        titulo.className = 'titulo-linha';
        titulo.textContent = f.nome;
        var linha = document.createElement('section');
        linha.className = 'row';
        for (var k = 0; k < f.itens.length; k++) {
            linha.appendChild(criarCartao(f.itens[k], f.app));
        }
        extra.appendChild(titulo);
        extra.appendChild(linha);
    }

    slideAtual = -1;
    mostrarSlide(0);

    if (focoEmExtra) {
        var primeiro = extra.querySelector('.movie') || document.querySelector('#apps .item');
        if (primeiro) {
            primeiro.focus();
        }
    }
}

function criarCartao(it, servico) {
    var c = document.createElement('div');
    c.className = 'movie item com-img';
    c.setAttribute('tabindex', '0');
    var url = '';
    if (it.f) {
        url = imgTmdb('w500', it.f);
    } else if (it.p) {
        url = imgTmdb('w342', it.p);
        c.className += ' so-poster';
    }
    if (url) {
        c.style.backgroundImage = "url('" + url + "')";
    }
    var nome = document.createElement('span');
    nome.className = 'movie-titulo';
    nome.textContent = it.n;
    c.appendChild(nome);
    c.onclick = function () {
        abrirTitulo(it, servico);
    };
    return c;
}

function servicosInstalados(it) {
    var r = [];
    var sv = it.sv || [];
    for (var i = 0; i < sv.length; i++) {
        var app = appDoServico(sv[i]);
        if (app) {
            r.push({ chave: sv[i], app: app });
        }
    }
    return r;
}

function abrirTitulo(it, servico) {
    if (servico) {
        var direto = appDoServico(servico);
        if (direto) {
            avisoFundo('Abrindo ' + SERVICOS[servico].rotulo);
            abrirApp(direto.p);
            return;
        }
    }
    var inst = servicosInstalados(it);
    if (inst.length === 1) {
        avisoFundo('Abrindo ' + SERVICOS[inst[0].chave].rotulo);
        abrirApp(inst[0].app.p);
        return;
    }
    abrirDetalhes(it);
}

function abrirDetalhes(it) {
    focoAntesPainel = document.activeElement;
    document.getElementById('pt-titulo').textContent = it.n;
    var meta = tipoTexto(it.t);
    if (it.a) {
        meta += '  ·  ' + it.a;
    }
    if (it.v > 0) {
        meta += '  ·  ★ ' + it.v.toFixed(1);
    }
    document.getElementById('pt-meta').textContent = meta;
    document.getElementById('pt-sinopse').textContent = it.s || 'Sem sinopse disponível.';
    var poster = imgTmdb('w342', it.p);
    document.getElementById('pt-poster').style.backgroundImage = poster ? "url('" + poster + "')" : 'none';

    var nomes = [];
    var sv = it.sv || [];
    for (var i = 0; i < sv.length; i++) {
        if (SERVICOS[sv[i]]) {
            nomes.push(SERVICOS[sv[i]].rotulo);
        }
    }
    var inst = servicosInstalados(it);
    var onde = nomes.length ? 'Disponível em: ' + nomes.join(', ') : 'Serviço de streaming não identificado.';
    if (nomes.length && inst.length === 0) {
        onde += ' (nenhum desses aplicativos está instalado)';
    }
    document.getElementById('pt-onde').textContent = onde;

    var caixa = document.getElementById('pt-opcoes');
    caixa.innerHTML = '';
    for (var k = 0; k < inst.length; k++) {
        (function (info) {
            var op = document.createElement('div');
            op.className = 'opcao item';
            op.setAttribute('tabindex', '0');
            var e = document.createElement('span');
            e.textContent = 'Abrir ' + SERVICOS[info.chave].rotulo;
            var v = document.createElement('span');
            v.className = 'valor';
            v.textContent = info.app.n;
            op.appendChild(e);
            op.appendChild(v);
            op.onclick = function () {
                fecharSubpainel();
                abrirApp(info.app.p);
            };
            caixa.appendChild(op);
        })(inst[k]);
    }

    document.getElementById('painel-titulo').classList.add('aberto');
    var alvo = caixa.querySelector('.item') || document.getElementById('op-titulo-fechar');
    alvo.focus();
}

function abrirCreditos() {
    voltarPersonalizar = true;
    document.getElementById('painel').classList.remove('aberto');
    document.getElementById('painel-creditos').classList.add('aberto');
    document.getElementById('op-creditos-fechar').focus();
}

/* Fecha os paineis de detalhes/creditos. Devolve true se havia algum aberto. */
function fecharSubpainel() {
    var ids = ['painel-titulo', 'painel-creditos'];
    for (var i = 0; i < ids.length; i++) {
        var p = document.getElementById(ids[i]);
        if (p.classList.contains('aberto')) {
            p.classList.remove('aberto');
            if (ids[i] === 'painel-creditos' && voltarPersonalizar) {
                voltarPersonalizar = false;
                abrirPainel(true);
                return true;
            }
            if (focoAntesPainel && document.body.contains(focoAntesPainel) && visivel(focoAntesPainel)) {
                focoAntesPainel.focus();
            } else {
                var alvo = focoInicial();
                if (alvo) {
                    alvo.focus();
                }
            }
            return true;
        }
    }
    return false;
}

function catalogoIniciar() {
    lerPrefCatalogo();
    catalogoCarregar();
    try {
        if (window.Android && window.Android.catalogoAuto) {
            window.Android.catalogoAuto();
        }
    } catch (e) {}
}

document.getElementById('hero-botao').onclick = function () {
