<script>
// Apps que aparecem primeiro (basta o nome conter a palavra, em minusculas).
// Para mudar a ordem ou incluir outros, edite esta lista.
var FAVORITOS = ['youtube', 'netflix', 'globoplay', 'unitv', 'uni tv'];

// Usado so quando a pagina e aberta fora da TV (previa no celular)
var DEMO = [
    { p: 'demo.youtube', n: 'YouTube' },
    { p: 'demo.netflix', n: 'Netflix' },
    { p: 'demo.globoplay', n: 'Globoplay' },
    { p: 'demo.unitv', n: 'UNI TV' }
];

// Textos do banner (conteudo de demonstracao, sem filmes ou marcas reais)
var SLIDES = [
    { etiqueta: 'Descubra algo novo', titulo: 'Seu próximo favorito começa aqui', meta: 'Em alta', desc: 'Seus aplicativos, filmes e séries em um só lugar.' },
    { etiqueta: 'Noite de cinema', titulo: 'Sua sessão começa quando você quiser', meta: 'Em alta', desc: 'Escolha um aplicativo e aproveite a tela grande da sala.' },
    { etiqueta: 'Novas histórias', titulo: 'Tudo o que você assiste, em um só lugar', meta: 'Novidades', desc: 'Abra seus aplicativos de streaming direto da tela inicial.' },
    { etiqueta: 'Séries em destaque', titulo: 'A próxima maratona está a um clique', meta: 'Dica', desc: 'Use as setas e o OK do controle remoto para navegar.' }
];

var ENGRENAGEM = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">' +
    '<circle cx="12" cy="12" r="8" stroke-width="2.4" stroke-dasharray="2.1 1.1"/>' +
    '<circle cx="12" cy="12" r="5.4" stroke-width="3.2"/></svg>';

var ultimaLista = '';
var iconeCache = {};
var abaAtual = 'inicio';
var modoFundo = 'cenas';
var listaFotos = [];
var timerAviso = null;
var slideAtual = 0;
var timerSlide = null;

function temAndroid() {
    return !!(window.Android && window.Android.apps);
}

function posicaoFavorito(app) {
    var nome = String(app.n).toLowerCase();
    for (var i = 0; i < FAVORITOS.length; i++) {
        if (nome.indexOf(FAVORITOS[i]) !== -1) {
            return i;
        }
    }
    return 999;
}

function ordenar(lista) {
    return lista
        .map(function (app, indice) {
            return { app: app, f: posicaoFavorito(app), i: indice };
        })
        .sort(function (a, b) {
            return (a.f - b.f) || (a.i - b.i);
        })
        .map(function (o) {
            return o.app;
        });
}

function abrirApp(pacote) {
    if (!temAndroid()) {
        alert('A abertura dos aplicativos funciona dentro da TV.');
        return;
    }
    if (pacote === '__config__') {
        window.Android.settings();
    } else {
        window.Android.launch(pacote);
    }
}

/* ---------- Aplicativos ---------- */

function aplicarIcone(tile, origem) {
    var caixa = tile.firstChild;
    caixa.textContent = '';
    caixa.className = 'app-icon com-img';
    var imagem = document.createElement('img');
    imagem.src = origem;
    caixa.appendChild(imagem);
    tile.setAttribute('data-ok', '1');
}

function criarTile(app) {
    var tile = document.createElement('div');
    tile.className = 'app item';
    tile.tabIndex = 0;
    tile.setAttribute('data-pkg', app.p);

    var icone = document.createElement('div');
    icone.className = 'app-icon';
    if (app.p === '__config__') {
        icone.innerHTML = ENGRENAGEM;
    } else {
        icone.textContent = app.n ? app.n.charAt(0).toUpperCase() : '?';
    }

    var nome = document.createElement('div');
    nome.className = 'app-label';
    nome.textContent = app.n;

    tile.appendChild(icone);
    tile.appendChild(nome);
    tile.onclick = function () {
        abrirApp(app.p);
    };

    if (iconeCache[app.p]) {
        aplicarIcone(tile, iconeCache[app.p]);
    }
    return tile;
}

function carregarIcones() {
    if (!temAndroid() || !window.Android.icone) {
        return;
    }
    var tiles = Array.prototype.slice.call(document.querySelectorAll('.app'));
    var i = 0;

    (function proximo() {
        var fim = Math.min(i + 3, tiles.length);
        for (; i < fim; i++) {
            var pacote = tiles[i].getAttribute('data-pkg');
            if (pacote === '__config__' || tiles[i].getAttribute('data-ok')) {
                continue;
            }
            var origem = iconeCache[pacote];
            if (origem === undefined) {
                try {
                    origem = window.Android.icone(pacote);
                } catch (e) {
                    origem = '';
                }
                iconeCache[pacote] = origem;
            }
            if (origem) {
