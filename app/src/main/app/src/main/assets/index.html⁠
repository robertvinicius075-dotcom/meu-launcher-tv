<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101114">
<title>Meu Launcher TV</title>

<style>
:root {
    --bg: #101114;
    --panel: #1b1d23;
    --text: #ffffff;
    --muted: #a6a8b2;
    --accent: #b7c7ff;
    --foco: #ffffff;
    --lateral: 4.5rem;
}

/* 1rem = 1,25% da largura da tela: tudo se ajusta a qualquer TV */
html {
    font-size: 1.25vw;
}

* {
    box-sizing: border-box;
}

html, body {
    height: 100%;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Roboto, Arial, sans-serif;
    height: 100vh;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
}

/* ---------- Fundo do banner (cenas de demonstracao) ---------- */

.arte {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 72%;
    overflow: hidden;
    display: none;
    z-index: 0;
    background: #181a22;
}

body.em-inicio .arte {
    display: block;
}

.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    -webkit-transition: opacity 0.9s ease;
    transition: opacity 0.9s ease;
}

.slide.ativo {
    opacity: 1;
}

.slide svg {
    display: block;
    width: 100%;
    height: 100%;
}

.foto-fundo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    background-color: #181a22;
    background-position: center center;
    background-repeat: no-repeat;
    -webkit-background-size: cover;
    background-size: cover;
}

.arte.modo-foto .slide {
    display: none;
}

.arte.modo-foto .foto-fundo {
    display: block;
}

body.fundo-preto,
body.fundo-preto html {
    background: #000000;
}

body.fundo-preto .arte {
    display: none;
}

body.fundo-preto .pontos,
body.fundo-foto .pontos {
    display: none;
}

.aviso-fundo {
    position: absolute;
    right: var(--lateral);
    top: 6.4rem;
    z-index: 30;
    max-width: 46rem;
    padding: 0.5rem 1.1rem;
    border-radius: 1.4rem;
    background: rgba(0,0,0,0.72);
    color: #ffffff;
    font-size: 1.1rem;
    opacity: 0;
    -webkit-transition: opacity 0.3s ease;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.aviso-fundo.mostra {
    opacity: 1;
}

.botao-fundo {
    margin-right: 0.9rem;
}

.oculto {
    display: none !important;
}

/* ---------- Catalogo de filmes e series ---------- */

body.com-catalogo #t-destaques,
body.com-catalogo #row-destaques {
    display: none;
}

body.com-catalogo #aba-inicio.ativa {
    overflow-y: auto;
}

body.com-catalogo #aba-inicio::-webkit-scrollbar {
    display: none;
}

body.com-catalogo #aba-inicio > * {
    flex-shrink: 0;
}

body.com-catalogo .hero-texto {
    flex: 0 0 auto;
    height: 20rem;
}

.slide.slide-cat {
    background-color: #181a22;
    background-repeat: no-repeat;
    background-position: center 20%;
    -webkit-background-size: cover;
    background-size: cover;
}

#hero-botao {
    display: inline-block;
    margin-top: 1rem;
}

.movie.com-img {
    -webkit-background-size: cover;
    background-size: cover;
    background-position: center 22%;
    background-repeat: no-repeat;
    background-color: #1c2030;
}

/* Sem imagem horizontal: o poster aparece inteiro, sem recorte */
.movie.com-img.so-poster {
    -webkit-background-size: auto 100%;
    background-size: auto 100%;
    background-position: center top;
}

.movie.com-img::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 62%;
    border-radius: 0 0 1rem 1rem;
    background: -webkit-linear-gradient(top, rgba(0,0,0,0), rgba(0,0,0,0.88));
    background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.88));
}

.movie-titulo {
    position: relative;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.painel-caixa {
    max-height: 94%;
    overflow-y: auto;
}

.painel-caixa::-webkit-scrollbar {
    display: none;
}

.painel-largo {
    width: 64rem;
}

.titulo-corpo {
    display: flex;
}

.titulo-poster {
    flex: none;
    width: 10rem;
    height: 15rem;
    margin-right: 1.8rem;
    border-radius: 0.8rem;
    background-color: #2a2d36;
    background-position: center;
    background-repeat: no-repeat;
    -webkit-background-size: cover;
    background-size: cover;
}

.titulo-texto {
    flex: 1 1 auto;
    min-width: 0;
}

.titulo-texto h2 {
    margin: 0 0 0.3rem;
    font-size: 2rem;
}

.titulo-sinopse {
    margin: 0.7rem 0;
    font-size: 1.15rem;
    line-height: 1.45;
    color: #d6d8e2;
}

.logo-tmdb {
    display: block;
    max-height: 2.6rem;
    margin: 0.4rem 0 1rem;
}

.creditos-texto {
    font-size: 1.15rem;
    line-height: 1.5;
    color: #d6d8e2;
}

/* ---------- Aba Ao vivo ---------- */

.vivo-topo {
    padding: 0 var(--lateral);
}

.vivo-status {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.1rem;
    color: var(--muted);
}

.vivo-acoes {
    display: flex;
    padding: 0.5rem var(--lateral) 0.3rem;
}

.pill {
    margin-right: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 2rem;
    background: rgba(255,255,255,0.12);
    color: #ffffff;
    font-size: 1.15rem;
    white-space: nowrap;
}

.pill:focus {
    background: #ffffff;
    color: #101114;
}

.chip {
    flex: none;
    margin-right: 0.8rem;
    padding: 0.55rem 1.3rem;
    border-radius: 2rem;
    background: rgba(255,255,255,0.08);
    color: #d6d8e2;
    font-size: 1.1rem;
    white-space: nowrap;
}

.chip.sel {
    background: rgba(183,199,255,0.3);
    color: #ffffff;
}

.chip:focus {
    background: #ffffff;
    color: #101114;
}

#vivo-canais {
    padding-bottom: 3rem;
}

/* Cabecalho compacto: sobra mais espaco para os canais */
#vivo-conteudo .vivo-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
}

#vivo-conteudo .titulo-grande {
    margin: 0.8rem 1.4rem 0.2rem 0;
    font-size: 1.7rem;
}

#vivo-conteudo .vivo-status {
    margin: 0.8rem 0 0.2rem;
}

#vivo-conteudo .vivo-acoes {
    padding: 0.4rem var(--lateral) 0.1rem;
}

#vivo-conteudo .vivo-acoes .pill {
    padding: 0.45rem 1.3rem;
    font-size: 1.05rem;
}

#vivo-conteudo #vivo-grupos {
    padding: 0.6rem var(--lateral) 0.5rem;
}

.canal {
    display: flex;
    align-items: center;
    margin: 0.4rem var(--lateral) 0;
    padding: 0.5rem 1.3rem;
    border-radius: 1rem;
    background: rgba(255,255,255,0.07);
}

.canal-logo {
    flex: none;
    width: 4.8rem;
    height: 3.1rem;
    margin-right: 1.3rem;
    border-radius: 0.6rem;
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 1.5rem;
    font-weight: bold;
}

.canal-logo img {
    max-width: 90%;
    max-height: 90%;
}

.canal-info {
    flex: 1 1 auto;
    min-width: 0;
}

.canal-nome {
    font-size: 1.35rem;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.canal-agora:empty {
    display: none;
}

.canal-agora {
    min-height: 1.4rem;
    font-size: 1.05rem;
    color: #c9cbd6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.canal-barra {
    width: 60%;
    height: 0.28rem;
    margin-top: 0.4rem;
    border-radius: 0.2rem;
    background: rgba(255,255,255,0.2);
    visibility: hidden;
    display: none;
}

.canal-barra i {
    display: block;
    height: 100%;
    border-radius: 0.2rem;
    background: #7f9cff;
}

.canal-depois {
    flex: none;
    width: 24rem;
    margin-left: 1.3rem;
    font-size: 1.05rem;
    color: #a6a8b2;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.canal:focus {
    background: #ffffff;
    color: #101114;
}

.canal:focus .canal-agora,
.canal:focus .canal-depois {
    color: #363943;
}

.canal:focus .canal-logo {
    background: rgba(16,17,20,0.1);
}

.canal.mais {
    justify-content: center;
    font-size: 1.2rem;
}

.endereco {
    margin: 0.6rem 0 1rem;
    padding: 1rem 1.4rem;
    border-radius: 1rem;
    background: #101114;
    color: #b7c7ff;
    font-size: 2.1rem;
    font-weight: bold;
    text-align: center;
}

.painel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 20;
    background: rgba(0,0,0,0.84);
    display: none;
    align-items: center;
    justify-content: center;
}

.painel.aberto {
    display: flex;
}

.painel-caixa {
    width: 52rem;
    padding: 2.4rem 2.6rem;
    border-radius: 1.6rem;
    background: #1b1d23;
}

.painel-caixa h2 {
    margin: 0 0 0.4rem 0;
    font-size: 2rem;
}

.painel-dica {
    margin: 0 0 1.4rem 0;
    font-size: 1.05rem;
    color: #a6a8b2;
}

.opcao {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.7rem;
    padding: 0.95rem 1.4rem;
    border-radius: 1rem;
    background: rgba(255,255,255,0.08);
    font-size: 1.3rem;
    color: #ffffff;
}

.opcao .valor {
    color: #b7c7ff;
    font-weight: bold;
}

.opcao:focus {
    background: #ffffff;
    color: #101114;
    outline: none;
}

.opcao:focus .valor {
    color: #101114;
}

.arte-sombra {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(180deg, rgba(16,17,20,0.75) 0%, rgba(16,17,20,0) 22%),
      linear-gradient(90deg, rgba(16,17,20,0.92) 0%, rgba(16,17,20,0.6) 34%, rgba(16,17,20,0) 68%),
      linear-gradient(180deg, rgba(16,17,20,0) 45%, #101114 100%);
}

/* ---------- Menu superior ---------- */

.topo {
    position: relative;
    z-index: 1;
    flex: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.2rem var(--lateral) 0;
}

.topo-esq,
.topo-dir {
    display: flex;
    align-items: center;
}

.avatar {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    margin-right: 1.6rem;
    background: rgba(255,255,255,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar svg {
    width: 1.7rem;
    height: 1.7rem;
    fill: rgba(255,255,255,0.88);
}

.abas {
    display: flex;
}

.item {
    outline: none;
}

.tab {
    font-size: 1.35rem;
    padding: 0.6rem 1.4rem;
    margin-right: 0.4rem;
    border-radius: 2rem;
    border: 0.15rem solid transparent;
    color: rgba(255,255,255,0.78);
}

.tab.sel {
    background: #ffffff;
    color: #101114;
    font-weight: bold;
}

.tab:focus {
    box-shadow: 0 0 0 0.22rem var(--accent);
}

.botao-config {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.16);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
}

.botao-config svg {
    width: 1.7rem;
    height: 1.7rem;
}

.botao-config:focus {
    background: #ffffff;
    color: #101114;
    -webkit-transform: scale(1.12);
    transform: scale(1.12);
}

.marca {
    margin-left: 1.2rem;
    font-size: 1.2rem;
    color: rgba(255,255,255,0.7);
}

/* ---------- Conteudo das abas ---------- */

main {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.aba {
    display: none;
}

.aba.ativa {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
}

/* Banner de destaque */

.hero-texto {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 var(--lateral) 1.2rem;
}

.hero-bloco {
    max-width: 58rem;
    opacity: 1;
    -webkit-transition: opacity 0.35s ease;
    transition: opacity 0.35s ease;
}

.hero-bloco.some {
    opacity: 0;
}

.etiqueta {
    display: inline-block;
    margin-bottom: 0.9rem;
    padding: 0.35rem 0.8rem;
    border-radius: 0.5rem;
    background: rgba(255,255,255,0.16);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: bold;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
}

.hero-logo {
    display: none;
    max-width: 28rem;
    max-height: 6rem;
    margin: 0 0 0.9rem;
    -o-object-fit: contain;
    object-fit: contain;
    filter: drop-shadow(0 0.1rem 0.6rem rgba(0,0,0,0.6));
}

.hero-logo.ligado {
    display: block;
}

h1.sem-texto {
    display: none;
}

h1 {
    margin: 0 0 0.8rem;
    font-size: 3rem;
    line-height: 1.1;
    text-shadow: 0 0.1rem 0.6rem rgba(0,0,0,0.5);
}

.hero-meta {
    max-width: 46rem;
    font-size: 1.3rem;
    line-height: 1.45;
    color: #e3e5ee;
}

.hero-meta strong {
    color: #ffffff;
    padding-right: 0.9rem;
    margin-right: 0.9rem;
    border-right: 0.12rem solid rgba(255,255,255,0.45);
}

.pontos {
    display: flex;
    align-items: center;
    padding-bottom: 0.3rem;
}

.ponto {
    width: 0.55rem;
    height: 0.55rem;
    margin-left: 0.5rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
}

.ponto.ativo {
    width: 0.75rem;
    height: 0.75rem;
    background: #ffffff;
}

/* Fileiras */

.titulo-linha {
    margin: 0;
    padding: 0 var(--lateral);
    font-size: 1.3rem;
    font-weight: bold;
    color: #f0f1f6;
}

.row {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding: 1rem var(--lateral) 1.1rem;
    scroll-padding-left: var(--lateral);
    scroll-padding-right: var(--lateral);
}

.row::-webkit-scrollbar {
    display: none;
}

/* Capas dos filmes e series (demonstracao) */

.movie {
    position: relative;
    flex: 0 0 auto;
    width: 15.2rem;
    height: 8.55rem;
    margin-right: 1.1rem;
    padding: 0.8rem;
    border-radius: 1rem;
    display: flex;
    align-items: flex-end;
    font-size: 1.15rem;
    font-weight: bold;
    text-shadow: 0 0.1rem 0.4rem rgba(0,0,0,0.6);
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #344c70, #1c2435);
}

.movie:nth-child(2) {
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #8a4650, #2a1b2a);
}

.movie:nth-child(3) {
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #8a7040, #30251b);
}

.movie:nth-child(4) {
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #3e7a76, #172d31);
}

.movie:nth-child(5) {
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #5d4a8a, #1d1a33);
}

.movie:nth-child(6) {
    background:
      radial-gradient(circle at 78% 28%, rgba(255,255,255,0.14), rgba(255,255,255,0) 46%),
      linear-gradient(140deg, #6f8a3e, #1f2a17);
}

.movie:focus {
    z-index: 2;
    -webkit-transform: scale(1.06);
    transform: scale(1.06);
    box-shadow: 0 0 0 0.2rem var(--foco), 0 0.6rem 1.6rem rgba(0,0,0,0.55);
}

/* Aplicativos (icones circulares) */

.app {
    position: relative;
    flex: 0 0 auto;
    width: 8.2rem;
    margin-right: 0.8rem;
    text-align: center;
    color: var(--muted);
    font-size: 1.2rem;
}

.app-icon {
    width: 6.2rem;
    height: 6.2rem;
    margin: 0 auto 0.5rem;
    border-radius: 50%;
    background: #2a2d36;
    background-clip: padding-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    font-weight: bold;
    color: var(--text);
    border: 0.2rem solid transparent;
    overflow: hidden;
}

.app-icon.com-img {
    background-color: #e9ebf1;
}

.app-icon img {
    display: block;
    width: 100%;
    height: 100%;
}

.app-icon svg {
    width: 3rem;
    height: 3rem;
}

.app-label {
    height: 1.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
}

.app:focus {
    z-index: 2;
    color: var(--text);
}

.app:focus .app-label {
    opacity: 1;
}

.app:focus .app-icon {
    border-color: var(--foco);
    -webkit-transform: scale(1.12);
    transform: scale(1.12);
    box-shadow: 0 0.5rem 1.4rem rgba(0,0,0,0.6);
}

/* Aba Apps (todos os aplicativos) */

.aba-rolagem.ativa {
    overflow-y: auto;
}

.aba-rolagem::-webkit-scrollbar {
    display: none;
}

.titulo-grande {
    margin: 1.6rem 0 0.4rem;
    font-size: 2rem;
}

.grade {
    display: flex;
    flex-wrap: wrap;
    padding: 1rem var(--lateral) 2rem;
}

.grade .app {
    margin-bottom: 0.8rem;
}

.grade .app-label {
    opacity: 1;
}

/* Abas ainda sem conteudo */

.vazio {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--muted);
    font-size: 1.4rem;
}

.vazio h2 {
    margin: 0 0 0.8rem;
    font-size: 2.2rem;
    color: var(--text);
}

.vazio p {
    margin: 0;
}

/* Visualizacao em tela pequena (so para testar no celular) */
@media (max-width: 700px) {
    html {
        font-size: 3vw;
    }

    :root {
        --lateral: 1.6rem;
    }

    body {
        height: auto;
        min-height: 100vh;
        overflow: auto;
    }

    .hero-texto {
        padding-top: 14rem;
    }

    h1 {
        font-size: 2.4rem;
    }

    .pontos {
        display: none;
    }
}
</style>
</head>

<body class="em-inicio">

<div class="arte" aria-hidden="true">

    <!-- Cena 1: por do sol nas montanhas -->
    <div class="slide ativo">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
            <defs>
                <linearGradient id="c1" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#2b2a5c"/>
                    <stop offset="0.55" stop-color="#b3507a"/>
                    <stop offset="1" stop-color="#f2a35e"/>
                </linearGradient>
                <radialGradient id="s1">
                    <stop offset="0" stop-color="#fff3c4"/>
                    <stop offset="0.35" stop-color="#ffc56b" stop-opacity="0.9"/>
                    <stop offset="1" stop-color="#ff8a4c" stop-opacity="0"/>
                </radialGradient>
            </defs>
