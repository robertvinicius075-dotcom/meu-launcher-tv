};

/* ---------- Aba Ao vivo ---------- */

var vivoGrupo = '';
var vivoLimite = 40;
var vivoMostrados = 0;
var vivoConfirmaRemover = false;

function vivoResumoLer() {
    try {
        if (window.Android && window.Android.vivoResumo) {
            return JSON.parse(window.Android.vivoResumo());
        }
    } catch (e) {}
    return null;
}

function hora2(ms) {
    var d = new Date(ms);
    var h = d.getHours();
    var m = d.getMinutes();
    return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
}

function vivoAtualizarTela() {
    var resumo = vivoResumoLer();
    var vazio = document.getElementById('vivo-vazio');
    var conteudo = document.getElementById('vivo-conteudo');

    if (!resumo || resumo.total === 0) {
        vazio.classList.remove('oculto');
        conteudo.classList.add('oculto');
        document.getElementById('vivo-vazio-texto').textContent = resumo
            ? 'Nenhuma lista de canais adicionada ainda.'
            : 'A lista de canais funciona no aplicativo instalado na TV.';
        return;
    }

    vazio.classList.add('oculto');
    conteudo.classList.remove('oculto');

    var status = resumo.total + ' canais';
    if (resumo.guiaEm > 0) {
        status += '  ·  Guia atualizado às ' + hora2(resumo.guiaEm);
    } else if (resumo.temGuia) {
        status += '  ·  Guia de programação ainda não carregado (toque em Atualizar)';
    } else {
        status += '  ·  Sem guia de programação';
    }
    document.getElementById('vivo-status').textContent = status;

    var existe = (vivoGrupo === '');
    var caixa = document.getElementById('vivo-grupos');
    caixa.innerHTML = '';
    var lista = [{ g: '', n: resumo.total, t: 'Todos' }];
    for (var i = 0; i < resumo.grupos.length; i++) {
        lista.push({ g: resumo.grupos[i].g, n: resumo.grupos[i].n, t: resumo.grupos[i].g });
        if (resumo.grupos[i].g === vivoGrupo) {
            existe = true;
        }
    }
    if (!existe) {
        vivoGrupo = '';
    }
    for (var k = 0; k < lista.length; k++) {
        (function (info) {
            var chip = document.createElement('div');
            chip.className = 'chip item' + (info.g === vivoGrupo ? ' sel' : '');
            chip.setAttribute('tabindex', '0');
            chip.textContent = info.t + ' (' + info.n + ')';
            chip.onclick = function () {
                vivoGrupo = info.g;
                var todos = caixa.querySelectorAll('.chip');
                for (var q = 0; q < todos.length; q++) {
                    todos[q].classList.remove('sel');
                }
                chip.classList.add('sel');
                vivoDesenharCanais(true);
            };
            caixa.appendChild(chip);
        })(lista[k]);
    }

    vivoDesenharCanais(true);
}

function vivoLerCanais(inicio, quantidade) {
    try {
        return JSON.parse(window.Android.vivoCanais(vivoGrupo, inicio, quantidade));
    } catch (e) {
        return { total: 0, itens: [] };
    }
}

function vivoDesenharCanais(zerar) {
    var caixa = document.getElementById('vivo-canais');
    if (zerar) {
        caixa.innerHTML = '';
        vivoMostrados = 0;
    } else {
        var antigo = caixa.querySelector('.mais');
        if (antigo) {
            caixa.removeChild(antigo);
        }
    }

    var dados = vivoLerCanais(vivoMostrados, vivoLimite);
    var primeiroNovo = null;
    for (var i = 0; i < dados.itens.length; i++) {
        var c = dados.itens[i];
        var linha = document.createElement('div');
        linha.className = 'canal item';
        linha.setAttribute('tabindex', '0');
        linha.setAttribute('data-i', String(c.i));

        var logo = document.createElement('div');
        logo.className = 'canal-logo';
        logo.textContent = (c.n || '?').charAt(0).toUpperCase();
        if (c.l) {
            (function (caixaLogo, endereco) {
                var img = document.createElement('img');
                img.onload = function () {
                    caixaLogo.textContent = '';
                    caixaLogo.appendChild(img);
                };
                img.src = endereco;
            })(logo, c.l);
        }

        var info = document.createElement('div');
        info.className = 'canal-info';
        var nome = document.createElement('div');
        nome.className = 'canal-nome';
        nome.textContent = c.n;
        var agora = document.createElement('div');
        agora.className = 'canal-agora';
        var barra = document.createElement('div');
        barra.className = 'canal-barra';
        barra.appendChild(document.createElement('i'));
        info.appendChild(nome);
        info.appendChild(agora);
        info.appendChild(barra);

        var depois = document.createElement('div');
        depois.className = 'canal-depois';

        linha.appendChild(logo);
        linha.appendChild(info);
        linha.appendChild(depois);
        linha.onclick = (function (indice) {
            return function () {
                if (window.Android && window.Android.vivoTocar) {
                    window.Android.vivoTocar(vivoGrupo, indice);
                }
            };
        })(c.i);
        caixa.appendChild(linha);
        if (!primeiroNovo) {
            primeiroNovo = linha;
        }
    }
    vivoMostrados += dados.itens.length;

    if (vivoMostrados < dados.total) {
        var mais = document.createElement('div');
        mais.className = 'canal mais item';
        mais.setAttribute('tabindex', '0');
        mais.textContent = 'Mostrar mais canais (' + (dados.total - vivoMostrados) + ')';
        mais.onclick = function () {
            vivoDesenharCanais(false);
        };
        caixa.appendChild(mais);
    }

    if (!zerar && primeiroNovo) {
        primeiroNovo.focus();
    }
    vivoPintarGuia();
}

function vivoPintarGuia() {
    if (!window.Android || !window.Android.vivoGuia) {
        return;
    }
    var linhas = document.querySelectorAll('#vivo-canais .canal[data-i]');
    if (linhas.length === 0) {
        return;
    }
    var ids = [];
    for (var i = 0; i < linhas.length; i++) {
        ids.push(linhas[i].getAttribute('data-i'));
    }
    var guia = {};
    try {
        guia = JSON.parse(window.Android.vivoGuia(ids.join(',')));
    } catch (e) {
        return;
    }
    var agora = new Date().getTime();
    for (var k = 0; k < linhas.length; k++) {
        var lista = guia[linhas[k].getAttribute('data-i')];
        var txtAgora = linhas[k].querySelector('.canal-agora');
        var txtDepois = linhas[k].querySelector('.canal-depois');
        var barra = linhas[k].querySelector('.canal-barra');
        txtAgora.textContent = '';
        txtDepois.textContent = '';
        barra.style.visibility = 'hidden';
        barra.style.display = 'none';
        if (!lista) {
            continue;
        }
        var atual = null;
        var proximo = null;
        for (var q = 0; q < lista.length; q++) {
            if (lista[q].s <= agora && agora < lista[q].e) {
                atual = lista[q];
            } else if (lista[q].s > agora && !proximo) {
                proximo = lista[q];
            }
        }
        if (atual) {
            txtAgora.textContent = hora2(atual.s) + '  ' + atual.t;
            var pct = Math.max(0, Math.min(100, (agora - atual.s) * 100 / (atual.e - atual.s)));
            barra.firstChild.style.width = pct + '%';
            barra.style.visibility = 'visible';
            barra.style.display = 'block';
        }
        if (proximo) {
            txtDepois.textContent = hora2(proximo.s) + '  ' + proximo.t;
        }
    }
}

function abrirPainelLista(doPersonalizar) {
    if (!window.Android || !window.Android.vivoIniciarServidor) {
        avisoFundo('Isso funciona no aplicativo instalado na TV');
        return;
    }
    if (doPersonalizar) {
        voltarPersonalizar = true;
        document.getElementById('painel').classList.remove('aberto');
    } else {
        focoAntesPainel = document.activeElement;
    }
    var end = '';
    try {
        end = window.Android.vivoIniciarServidor();
    } catch (e) {
        end = '';
    }
    document.getElementById('vivo-end').textContent = end ||
        'Não consegui iniciar. Confira se a TV está no Wi-Fi.';
    document.getElementById('painel-lista').classList.add('aberto');
    document.getElementById('op-lista-fechar').focus();
}

function fecharPainelLista() {
    var p = document.getElementById('painel-lista');
    if (!p.classList.contains('aberto')) {
        return;
    }
    p.classList.remove('aberto');
    try {
        if (window.Android && window.Android.vivoPararServidor) {
            window.Android.vivoPararServidor();
        }
    } catch (e) {}
    if (voltarPersonalizar) {
        voltarPersonalizar = false;
        abrirPainel(true);
        return;
    }
    if (focoAntesPainel && visivel(focoAntesPainel)) {
        focoAntesPainel.focus();
    }
}

window.aoVivoMudou = function (tipo, mensagem) {
    if (mensagem) {
        avisoFundo(mensagem);
    }
    if (tipo === 'chave') {
        fecharPainelLista();
        catalogoCarregar();
    } else if (tipo === 'catalogo') {
        catalogoCarregar();
    } else if (tipo === 'catalogo-erro') {
        return;
    } else if (tipo === 'lista') {
        fecharPainelLista();
        vivoGrupo = '';
        if (abaAtual === 'aovivo') {
            vivoAtualizarTela();
            var primeiro = document.getElementById('vivo-atualizar');
            if (primeiro && visivel(primeiro)) {
                primeiro.focus();
            }
        }
    } else if (tipo === 'guia') {
        if (abaAtual === 'aovivo') {
            var resumo = vivoResumoLer();
            if (resumo) {
                var texto = resumo.total + ' canais  ·  Guia atualizado às ' + hora2(resumo.guiaEm);
                document.getElementById('vivo-status').textContent = texto;
            }
            vivoPintarGuia();
        }
    }
};

document.getElementById('vivo-add1').onclick = function () {
    abrirPainelLista(false);
};
document.getElementById('vivo-add2').onclick = function () {
    abrirPainelLista(false);
};
document.getElementById('op-lista-fechar').onclick = fecharPainelLista;

document.getElementById('vivo-atualizar').onclick = function () {
    if (window.Android && window.Android.vivoAtualizar) {
        avisoFundo('Atualizando lista e guia...');
        window.Android.vivoAtualizar();
    }
};

document.getElementById('vivo-remover').onclick = function () {
    var botao = document.getElementById('vivo-remover');
    if (!vivoConfirmaRemover) {
        vivoConfirmaRemover = true;
        botao.textContent = 'Confirmar: remover lista';
        setTimeout(function () {
            vivoConfirmaRemover = false;
            botao.textContent = 'Remover lista';
        }, 5000);
        return;
    }
    vivoConfirmaRemover = false;
    botao.textContent = 'Remover lista';
    if (window.Android && window.Android.vivoRemover) {
        window.Android.vivoRemover();
    }
    vivoGrupo = '';
    vivoAtualizarTela();
    var add = document.getElementById('vivo-add1');
    if (add && visivel(add)) {
        add.focus();
    }
    avisoFundo('Lista removida');
};

setInterval(function () {
    if (abaAtual === 'aovivo' && !document.hidden) {
        vivoPintarGuia();
    }
}, 60000);

/* ---------- Personalizar: ordem das fileiras e o que mostrar ---------- */

var LAYOUT_PADRAO = { ordem: 'destaques', dest: true, apps: true };
var layout = { ordem: 'destaques', dest: true, apps: true };
var focoAntesPainel = null;

function lerLayout() {
    var l = { ordem: LAYOUT_PADRAO.ordem, dest: true, apps: true };
    try {
        var salvo = JSON.parse(localStorage.getItem('layout') || 'null');
        if (salvo) {
            l.ordem = salvo.ordem === 'apps' ? 'apps' : 'destaques';
            l.dest = salvo.dest !== false;
            l.apps = salvo.apps !== false;
        }
    } catch (e) {}
    return l;
}

function aplicarLayout() {
    var base = document.getElementById('aba-inicio');
    var gd = document.getElementById('grupo-dest');
    var ta = document.getElementById('t-apps');
    var ra = document.getElementById('apps');

    if (layout.ordem === 'apps') {
        base.appendChild(ta);
        base.appendChild(ra);
        base.appendChild(gd);
    } else {
        base.appendChild(gd);
        base.appendChild(ta);
        base.appendChild(ra);
    }

    var pares = [[gd, gd, layout.dest], [ta, ra, layout.apps]];
    for (var i = 0; i < pares.length; i++) {
        if (pares[i][2]) {
            pares[i][0].classList.remove('oculto');
            pares[i][1].classList.remove('oculto');
        } else {
            pares[i][0].classList.add('oculto');
            pares[i][1].classList.add('oculto');
        }
    }

    try {
        localStorage.setItem('layout', JSON.stringify(layout));
    } catch (e) {}
}

function textoFundoCurto() {
    if (modoFundo === 'preto') {
        return 'Tudo preto';
    }
    if (modoFundo.indexOf('foto:') === 0) {
        return nomeBonito(modoFundo.substring(5));
    }
    return 'Automático (banners)';
}

function atualizarPainel() {
    document.getElementById('v-fundo').textContent = textoFundoCurto();
    document.getElementById('v-ordem').textContent =
        layout.ordem === 'apps' ? 'Seus aplicativos' : 'Em destaque para você';
    document.getElementById('v-dest').textContent = layout.dest ? 'Mostrar' : 'Ocultar';
    document.getElementById('v-apps').textContent = layout.apps ? 'Mostrar' : 'Ocultar';
    var temChave = catalogoTemChave();
    document.getElementById('v-catalogo').textContent = temChave
        ? (catalogoLigado ? 'Ligado' : 'Desligado') : 'Falta a chave';
    document.getElementById('v-tmdb').textContent = temChave ? 'Configurada' : 'Falta';
}

function painelAberto() {
    return !!document.querySelector('.painel.aberto');
}

function abrirPainel(reabrir) {
    if (!reabrir) {
        focoAntesPainel = document.activeElement;
    }
    atualizarPainel();
    document.getElementById('painel').classList.add('aberto');
    document.getElementById('op-fundo').focus();
}

function fecharPainel() {
    document.getElementById('painel').classList.remove('aberto');
    if (focoAntesPainel && visivel(focoAntesPainel)) {
        focoAntesPainel.focus();
    } else {
        document.getElementById('btn-fundo').focus();
    }
}

document.getElementById('btn-fundo').onclick = function () {
