/* ---------- Navegacao pelo controle remoto ---------- */

function visivel(elemento) {
    return elemento.offsetWidth > 0 && elemento.offsetHeight > 0;
}

function mover(direcao) {
    var atual = document.activeElement;
    var seletor = painelAberto() ? '.painel.aberto .item' : '.item';
    var itens = Array.prototype.slice.call(document.querySelectorAll(seletor)).filter(visivel);

    if (!atual || !atual.classList || !atual.classList.contains('item') || !visivel(atual)) {
        var primeiro = (painelAberto() ? null : document.querySelector('#apps .item')) || itens[0];
        if (primeiro) {
            primeiro.focus();
        }
        return;
    }

    var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;
    var r = atual.getBoundingClientRect();
    var cx = r.left + r.width / 2;
    var cy = r.top + r.height / 2;
    var horizontal = (direcao === 'left' || direcao === 'right');
    var candidatos = [];
    var menorPrimario = 1e9;

    for (var i = 0; i < itens.length; i++) {
        if (itens[i] === atual) {
            continue;
        }
        var rc = itens[i].getBoundingClientRect();
        var dx = (rc.left + rc.width / 2) - cx;
        var dy = (rc.top + rc.height / 2) - cy;
        var primario;
        var secundario;

        if (horizontal) {
            if (Math.abs(dy) > Math.max(r.height * 0.6, rem)) {
                continue;
            }
            if (direcao === 'right' && dx <= 1) {
                continue;
            }
            if (direcao === 'left' && dx >= -1) {
                continue;
            }
            primario = Math.abs(dx);
            secundario = Math.abs(dy);
        } else {
            if (direcao === 'down' && dy <= 4) {
                continue;
            }
            if (direcao === 'up' && dy >= -4) {
                continue;
            }
            primario = Math.abs(dy);
            secundario = Math.abs(dx);
        }

        candidatos.push({ el: itens[i], p: primario, s: secundario });
        if (primario < menorPrimario) {
            menorPrimario = primario;
        }
    }

    if (candidatos.length === 0) {
        return;
    }

    // Dentro de uma tela que rola, a seta vertical anda primeiro pelos itens da propria tela
    // (assim a fileira de cima nao e pulada quando o menu esta mais perto na tela)
    if (!horizontal) {
        var contAtual = containerDeRolagem(atual);
        if (contAtual) {
            var dentro = [];
            var menorDentro = 1e9;
            for (var d = 0; d < candidatos.length; d++) {
                if (contAtual.contains(candidatos[d].el)) {
                    dentro.push(candidatos[d]);
                    if (candidatos[d].p < menorDentro) {
                        menorDentro = candidatos[d].p;
                    }
                }
            }
            if (dentro.length > 0) {
                candidatos = dentro;
                menorPrimario = menorDentro;
            }
        }
    }

    var melhor = null;
    var melhorS = 1e9;
    for (var k = 0; k < candidatos.length; k++) {
        var c = candidatos[k];
        if (horizontal) {
            if (melhor === null || c.p < melhorS) {
                melhor = c.el;
                melhorS = c.p;
            }
        } else if (c.p <= menorPrimario + rem * 1.5 && c.s < melhorS) {
            melhor = c.el;
            melhorS = c.s;
        }
    }

    // Subindo ate o menu: volta sempre para a aba que esta aberta
    // (a engrenagem se alcanca com a seta para a direita)
    if (direcao === 'up' && melhor &&
            (melhor.classList.contains('tab') || melhor.id === 'btn-config' || melhor.id === 'btn-fundo')) {
        melhor = document.querySelector('.tab.sel') || melhor;
    }

    if (melhor) {
        melhor.focus();
    }
}

/* ---------- Rolagem: item focado sempre inteiro na tela; subir ate o menu volta ao topo ---------- */

function containerDeRolagem(el) {
    var n = el;
    while (n && n !== document.body) {
        if (n.id === 'aba-inicio' || n.id === 'aba-aovivo') {
            return n;
        }
        n = n.parentNode;
    }
    return null;
}

function primeiraLinhaVisivel(cont) {
    var linhas = cont.querySelectorAll('.row');
    for (var i = 0; i < linhas.length; i++) {
        if (linhas[i].offsetHeight > 0 && linhas[i].id !== 'vivo-grupos') {
            return linhas[i];
        }
    }
    return null;
}

function noCabecalhoDoAoVivo(el) {
    var n = el;
    while (n && n !== document.body) {
        if (n.id === 'vivo-grupos' || n.id === 'vivo-vazio' ||
                (n.classList && n.classList.contains('vivo-acoes'))) {
            return true;
        }
        n = n.parentNode;
    }
    return false;
}

function ajustarRolagem(el) {
    if (!el || !el.classList) {
        return;
    }
    var ai = document.getElementById('aba-inicio');
    var av = document.getElementById('aba-aovivo');
    if (el.classList.contains('tab') || el.id === 'btn-config' || el.id === 'btn-fundo') {
        ai.scrollTop = 0;
        av.scrollTop = 0;
        return;
    }
    var cont = containerDeRolagem(el);
    if (!cont || cont.scrollHeight <= cont.clientHeight) {
        return;
    }
    var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;
    var margem = rem * 0.8;
    var topo = el.getBoundingClientRect().top;
    var fundo = el.getBoundingClientRect().bottom;

    if (cont.id === 'aba-inicio') {
        if (el.id === 'hero-botao') {
            cont.scrollTop = 0;
            return;
        }
        var linha = el.parentNode;
        if (linha && linha.classList && linha.classList.contains('row')) {
            if (linha === primeiraLinhaVisivel(cont)) {
                cont.scrollTop = 0;
                return;
            }
            var tit = linha.previousElementSibling;
            if (tit && tit.classList && tit.classList.contains('titulo-linha')) {
                topo = tit.getBoundingClientRect().top;
            }
            fundo = linha.getBoundingClientRect().bottom;
        }
    } else if (noCabecalhoDoAoVivo(el)) {
        cont.scrollTop = 0;
        return;
    }

    var cr = cont.getBoundingClientRect();
    var delta = 0;
    if (topo < cr.top + margem) {
        delta = topo - (cr.top + margem);
    } else if (fundo > cr.bottom - margem) {
        delta = fundo - (cr.bottom - margem);
    }
    if (delta !== 0) {
        cont.scrollTop = cont.scrollTop + delta;
    }
}

document.addEventListener('focus', function (e) {
    var alvo = e.target;
    ajustarRolagem(alvo);
    // o navegador tambem rola sozinho ao focar: confere de novo logo depois
    setTimeout(function () {
        if (document.activeElement === alvo) {
            ajustarRolagem(alvo);
        }
    }, 0);
}, true);

document.addEventListener('keydown', function (evento) {
    var tecla = evento.keyCode;

    if (tecla === 37) {
        evento.preventDefault();
        mover('left');
    } else if (tecla === 39) {
        evento.preventDefault();
        mover('right');
    } else if (tecla === 38) {
        evento.preventDefault();
        mover('up');
    } else if (tecla === 40) {
        evento.preventDefault();
        mover('down');
    } else if (tecla === 13 || tecla === 23) {
        var atual = document.activeElement;
        if (atual && atual.classList && atual.classList.contains('item')) {
            evento.preventDefault();
            if (evento.repeat) {
                return;
            }
            if (atual.classList.contains('tab')) {
                mover('down');
            } else {
                atual.click();
            }
        }
    } else if (tecla === 27 || tecla === 4 || tecla === 8) {
        evento.preventDefault();
        window.aoVoltar();
    }
}, false);

