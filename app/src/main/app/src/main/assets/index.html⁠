        o.push('foto:' + listaFotos[i]);
    }
    return o;
}

function textoFundo(modo) {
    if (modo === 'preto') {
        return 'Fundo: tudo preto';
    }
    if (modo.indexOf('foto:') === 0) {
        return 'Fundo: ' + nomeBonito(modo.substring(5));
    }
    return 'Fundo: automático (banners)';
}

function proximoFundo() {
    var o = opcoesFundo();
    var i = 0;
    for (var k = 0; k < o.length; k++) {
        if (o[k] === modoFundo) {
            i = k;
        }
    }
    var novo = o[(i + 1) % o.length];
    aplicarFundo(novo);
    avisoFundo(textoFundo(modoFundo));
}

function iniciarFundo() {
    listaFotos = lerFotos();
    var salvo = 'cenas';
    try {
        salvo = localStorage.getItem('fundo') || 'cenas';
    } catch (e) {}
    var o = opcoesFundo();
    var existe = false;
    for (var k = 0; k < o.length; k++) {
        if (o[k] === salvo) {
            existe = true;
        }
    }
    aplicarFundo(existe ? salvo : 'cenas');
}

